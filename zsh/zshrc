# WezTerm + tmux integration
[[ -r "$HOME/.config/zsh/wezterm-tmux.zsh" ]] &&
  source "$HOME/.config/zsh/wezterm-tmux.zsh"

# Enable Powerlevel10k instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# User-installed binaries must be available before Oh My Zsh loads plugins.
export PATH="$HOME/.local/bin:$PATH"

# Oh My Zsh.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Use fd as the fzf file source when available.
# These variables must be defined before the fzf plugin is loaded.
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi

# --style=full needs fzf >= 0.55.0; older fzf (e.g. from a system package
# manager shadowing the managed install) rejects it outright and takes the
# whole shell startup down with it, so only add it when supported.
_fzf_style_opt=""
if command -v fzf >/dev/null 2>&1; then
  autoload -Uz is-at-least
  if is-at-least 0.55.0 "$(fzf --version 2>/dev/null | awk '{print $1}')"; then
    _fzf_style_opt="--style=full"
  fi
fi

# Catppuccin Mocha-inspired fzf interface.
export FZF_DEFAULT_OPTS="
  --height=85%
  --layout=reverse
  $_fzf_style_opt
  --border=rounded
  --padding=1,2
  --margin=1
  --info=inline-right
  --separator='─'
  --scrollbar='│'
  --prompt='  '
  --pointer='▶'
  --marker='✓'
  --input-label=' Search '
  --list-label=' Results '
  --preview-label=' Preview '
  --bind='ctrl-/:toggle-preview'
  --bind='alt-j:preview-down'
  --bind='alt-k:preview-up'
  --bind='ctrl-d:half-page-down'
  --bind='ctrl-u:half-page-up'
  --color='bg:#1e1e2e'
  --color='bg+:#313244'
  --color='fg:#cdd6f4'
  --color='fg+:#cdd6f4'
  --color='hl:#f38ba8'
  --color='hl+:#f38ba8'
  --color='border:#89b4fa'
  --color='label:#cba6f7'
  --color='prompt:#89b4fa'
  --color='pointer:#f5e0dc'
  --color='marker:#a6e3a1'
  --color='spinner:#f5c2e7'
  --color='header:#f9e2af'
  --color='info:#a6adc8'
  --color='separator:#45475a'
  --color='scrollbar:#585b70'
  --color='preview-border:#89b4fa'
"
unset _fzf_style_opt

# Ctrl+T: select files with preview.
export FZF_CTRL_T_OPTS="
  --preview '
    if [ -d {} ]; then
      command ls -la {} 2>/dev/null
    elif command -v bat >/dev/null 2>&1; then
      bat --color=always --style=numbers --line-range=:300 {}
    elif command -v batcat >/dev/null 2>&1; then
      batcat --color=always --style=numbers --line-range=:300 {}
    else
      sed -n \"1,300p\" {}
    fi
  '
  --preview-window='right,55%,border-rounded,<90(down,45%,border-rounded)'
  --bind='ctrl-/:change-preview-window(right,55%|down,45%|hidden|)'
"

# Alt+C: select directories.
export FZF_ALT_C_OPTS="
  --preview='command ls -la {} 2>/dev/null'
  --preview-window='right,50%,border-rounded,<90(down,40%,border-rounded)'
"

# Ctrl+R: search command history.
export FZF_CTRL_R_OPTS="
  --no-preview
  --input-label=' History '
  --list-label=' Commands '
  --bind='ctrl-y:execute-silent(echo -n {2..} | pbcopy 2>/dev/null || echo -n {2..} | xclip -selection clipboard 2>/dev/null)+abort'
"

plugins=(
  git
  zsh-autosuggestions
  zsh-history-substring-search
  you-should-use
  fzf
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

# Powerlevel10k configuration.
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# Pay Respects:
# Press `f` after a failed command to suggest a correction.
if command -v pay-respects >/dev/null 2>&1; then
  eval "$(pay-respects zsh --alias)"
fi
